<%- include('../partials/header') %>

<h1>Categoria: <%= categoria.nome %></h1>

<a href="/produtos">Voltar para todos os produtos</a>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
    </tr>

    <% produtos.forEach(p => { %>
        <tr>
            <td><%= p.nome %></td>
            <td>R$ <%= p.preco.toFixed(2) %></td>
            <td><%= p.quantidade %></td>
        </tr>
    <% }) %>

    <% if (produtos.length === 0) { %>
        <tr>
            <td colspan="3">Nenhum produto nessa categoria.</td>
        </tr>
    <% } %>
</table>

<%- include('../partials/footer') %>
